# Morphindex — variables d'environnement
# À déclarer dans Vercel : Settings → Environment Variables.
# Ne JAMAIS commiter les vraies valeurs : ce fichier ne contient que les noms.

# --- Supabase -------------------------------------------------------------
# Depuis le dashboard Supabase : Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ⚠️ Clé d'administration : contourne l'RLS. Serveur uniquement.
# Ne doit JAMAIS être exposée au navigateur ni préfixée NEXT_PUBLIC_/VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe ---------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Identifiants de prix (Stripe → Produits). Voir docs/BACKEND.md §4.
STRIPE_PRICE_MONTHLY=

# --- Application ----------------------------------------------------------
APP_ORIGIN=https://morphindex.com
